@inject IRedmineService RedmineService
@inject AppState AppState
@inject NotificationService Notification

<!-- Barra de filtros -->
<div class="kanban-filters">
    <div class="filter-group">
        <input type="text" class="filter-search" placeholder="Buscar tareas..." 
               @bind="_searchText" @bind:event="oninput" @onkeyup="ApplyFilters" />
    </div>
    
    <div class="filter-group">
        <select class="filter-select" @bind="_selectedProjectId" @bind:after="ApplyFilters">
            <option value="0">Todos los proyectos</option>
            @foreach (var project in _projects)
            {
                <option value="@project.Id">@project.Name</option>
            }
        </select>
    </div>
    
    <div class="filter-group">
        <select class="filter-select" @bind="_selectedPriorityId" @bind:after="ApplyFilters">
            <option value="0">Todas las prioridades</option>
            @foreach (var priority in _priorities)
            {
                <option value="@priority.Id">@priority.Name</option>
            }
        </select>
    </div>
    
    <div class="filter-group">
        <select class="filter-select" value="@_selectedAssignedUserId" @onchange="OnAssignedUserChanged">
            <option value="0">Todos los usuarios</option>
            @foreach (var user in _assignedUsers)
            {
                <option value="@user.Id">@user.Name</option>
            }
        </select>
    </div>
    
    <div class="filter-group filter-dates">
        <label>Vence desde:</label>
        <input type="date" class="filter-date" @bind="_dueDateFrom" @bind:after="ApplyFilters" />
        <label>hasta:</label>
        <input type="date" class="filter-date" @bind="_dueDateTo" @bind:after="ApplyFilters" />
    </div>
    
    @if (HasActiveFilters)
    {
        <button class="btn-clear-filters" @onclick="ClearFilters">Limpiar filtros</button>
    }
    
    <div class="filter-stats">
        <span>@_filteredIssueCount de @_totalIssueCount tareas</span>
    </div>
</div>

<div class="kanban-board">
    @if (_isLoading)
    {
        <div class="kanban-loading">
            <LoadingSpinner Message="Cargando tareas..." />
        </div>
    }
    else if (_errorMessage != null)
    {
        <div class="kanban-error">
            <p>@_errorMessage</p>
            <button class="btn btn-primary" @onclick="LoadData">Reintentar</button>
        </div>
    }
    else
    {
        @foreach (var column in _filteredColumns)
        {
            <KanbanColumn Column="column" OnIssueMoved="HandleIssueMoved" OnIssueClicked="HandleIssueClicked" />
        }
    }
</div>

<!-- Modal de detalles -->
<IssueDetailModal IsVisible="_showModal" 
                  Issue="_selectedIssue" 
                  OnClose="CloseModal"
                  OnIssueUpdated="HandleIssueUpdated" />

@code {
    private List<KanbanColumnData> _columns = new();
    private List<KanbanColumnData> _filteredColumns = new();
    private List<RedmineIssue> _allIssues = new();
    private List<RedmineProject> _projects = new();
    private List<RedmineReference> _priorities = new();
    private List<RedmineReference> _assignedUsers = new();
    private bool _isLoading = true;
    private string? _errorMessage;
    
    // Filtros
    private string _searchText = string.Empty;
    private int _selectedProjectId = 0;
    private int _selectedPriorityId = 0;
    private int _selectedAssignedUserId = 0;
    private DateTime? _dueDateFrom;
    private DateTime? _dueDateTo;
    
    // Modal
    private bool _showModal = false;
    private RedmineIssue _selectedIssue = new();
    
    // Stats
    private int _totalIssueCount = 0;
    private int _filteredIssueCount = 0;
    
    private bool HasActiveFilters => 
        !string.IsNullOrWhiteSpace(_searchText) || 
        _selectedProjectId > 0 || 
        _selectedPriorityId > 0 ||
        _selectedAssignedUserId > 0 ||
        _dueDateFrom.HasValue ||
        _dueDateTo.HasValue;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var apiKey = AppState.ApiKey;
            if (string.IsNullOrEmpty(apiKey))
            {
                _errorMessage = "No hay sesión activa";
                return;
            }

            // Obtener datos en paralelo
            var statusesTask = RedmineService.GetStatusesAsync(apiKey);
            var issuesTask = RedmineService.GetMyIssuesAsync(apiKey);
            var projectsTask = RedmineService.GetProjectsAsync(apiKey);
            var prioritiesTask = RedmineService.GetPrioritiesAsync(apiKey);
            var usersTask = RedmineService.GetUsersAsync(apiKey);

            await Task.WhenAll(statusesTask, issuesTask, projectsTask, prioritiesTask, usersTask);

            var statuses = await statusesTask;
            _allIssues = await issuesTask;
            _projects = await projectsTask;
            _priorities = (await prioritiesTask).ToList();
            _assignedUsers = (await usersTask).ToList();
            
            _totalIssueCount = _allIssues.Count;

            // Crear columnas basadas en los estados
            _columns = statuses
                .Where(s => !s.IsClosed)
                .OrderBy(s => s.Id)
                .Select(status => new KanbanColumnData
                {
                    Status = status,
                    Issues = _allIssues
                        .Where(i => i.Status?.Id == status.Id)
                        .OrderByDescending(i => i.Priority?.Id ?? 0)
                        .ThenBy(i => i.DueDate)
                        .ToList()
                })
                .ToList();

            if (_columns.Count == 0)
            {
                _errorMessage = "No se encontraron estados configurados en Redmine";
            }
            
            ApplyFilters();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error al cargar datos: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }
    
    private void ApplyFilters()
    {
        _filteredColumns = _columns.Select(col => new KanbanColumnData
        {
            Status = col.Status,
            WipLimit = col.WipLimit,
            Issues = col.Issues.Where(issue => MatchesFilters(issue)).ToList()
        }).ToList();
        
        _filteredIssueCount = _filteredColumns.Sum(c => c.Issues.Count);
        StateHasChanged();
    }
    
    private bool MatchesFilters(RedmineIssue issue)
    {
        // Filtro de búsqueda por texto
        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var searchLower = _searchText.ToLower();
            var matchesText = 
                issue.Subject.ToLower().Contains(searchLower) ||
                issue.Id.ToString().Contains(searchLower) ||
                (issue.Description?.ToLower().Contains(searchLower) ?? false);
            
            if (!matchesText) return false;
        }
        
        // Filtro por proyecto
        if (_selectedProjectId > 0 && issue.Project?.Id != _selectedProjectId)
            return false;
        
        // Filtro por prioridad
        if (_selectedPriorityId > 0 && issue.Priority?.Id != _selectedPriorityId)
            return false;
        
        // Filtro por usuario asignado
        if (_selectedAssignedUserId > 0 && issue.AssignedTo?.Id != _selectedAssignedUserId)
            return false;
        
        // Filtro por fecha de vencimiento
        if (_dueDateFrom.HasValue && (!issue.DueDate.HasValue || issue.DueDate < _dueDateFrom))
            return false;
            
        if (_dueDateTo.HasValue && (!issue.DueDate.HasValue || issue.DueDate > _dueDateTo))
            return false;
        
        return true;
    }
    
    private void ClearFilters()
    {
        _searchText = string.Empty;
        _selectedProjectId = 0;
        _selectedPriorityId = 0;
        _selectedAssignedUserId = 0;
        _dueDateFrom = null;
        _dueDateTo = null;
        ApplyFilters();
    }

    private async Task HandleIssueMoved(IssueMoveEventArgs args)
    {
        var apiKey = AppState.ApiKey;
        if (string.IsNullOrEmpty(apiKey)) 
        {
            Notification.ShowError("Sesión no válida. Por favor, inicie sesión nuevamente.");
            return;
        }

        // Encontrar el issue y las columnas (usar _columns original)
        var sourceColumn = _columns.FirstOrDefault(c => c.Issues.Any(i => i.Id == args.IssueId));
        var targetColumn = _columns.FirstOrDefault(c => c.Status.Id == args.NewStatusId);

        if (sourceColumn == null || targetColumn == null) return;

        var issue = sourceColumn.Issues.FirstOrDefault(i => i.Id == args.IssueId);
        if (issue == null) return;
        
        if (sourceColumn.Status.Id == targetColumn.Status.Id) return;

        // Actualización optimista
        sourceColumn.Issues.Remove(issue);
        var previousStatus = issue.Status;
        
        issue.Status = new RedmineReference 
        { 
            Id = targetColumn.Status.Id, 
            Name = targetColumn.Status.Name 
        };
        
        targetColumn.Issues.Insert(0, issue);
        ApplyFilters(); // Reaplicar filtros para actualizar vista

        var result = await RedmineService.UpdateIssueStatusWithResultAsync(apiKey, args.IssueId, args.NewStatusId);

        if (!result.Success)
        {
            // Rollback
            targetColumn.Issues.Remove(issue);
            issue.Status = previousStatus;
            sourceColumn.Issues.Insert(0, issue);
            ApplyFilters();
            
            Notification.ShowError(result.ErrorMessage ?? "Error al actualizar el estado.");
        }
        else
        {
            Notification.ShowSuccess($"Tarea #{args.IssueId} movida a '{targetColumn.Status.Name}'");
        }
    }
    
    private void HandleIssueClicked(RedmineIssue issue)
    {
        _selectedIssue = issue;
        _showModal = true;
    }
    
    private void CloseModal()
    {
        _showModal = false;
    }
    
    private void HandleIssueUpdated(RedmineIssue updatedIssue)
    {
        // Actualizar el issue en las columnas
        foreach (var column in _columns)
        {
            var issue = column.Issues.FirstOrDefault(i => i.Id == updatedIssue.Id);
            if (issue != null)
            {
                // Actualizar propiedades del issue
                issue.Priority = updatedIssue.Priority;
                issue.AssignedTo = updatedIssue.AssignedTo;
                break;
            }
        }
        ApplyFilters();
    }

    public async Task RefreshAsync()
    {
        await LoadData();
    }

    private async Task OnAssignedUserChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var userId))
        {
            _selectedAssignedUserId = userId;
            await LoadIssuesByAssignee();
        }
    }

    private async Task LoadIssuesByAssignee()
    {
        _isLoading = true;
        StateHasChanged();
        try
        {
            var apiKey = AppState.ApiKey;
            if (string.IsNullOrEmpty(apiKey)) return;
            _allIssues = await RedmineService.GetIssuesByAssigneeAsync(apiKey, _selectedAssignedUserId);
            _totalIssueCount = _allIssues.Count;
            // Recalcular columnas
            var statuses = await RedmineService.GetStatusesAsync(apiKey);
            _columns = statuses
                .Where(s => !s.IsClosed)
                .OrderBy(s => s.Id)
                .Select(status => new KanbanColumnData
                {
                    Status = status,
                    Issues = _allIssues
                        .Where(i => i.Status?.Id == status.Id)
                        .OrderByDescending(i => i.Priority?.Id ?? 0)
                        .ThenBy(i => i.DueDate)
                        .ToList()
                })
                .ToList();
            ApplyFilters();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error al cargar tareas: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }
}
