@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations

@inject IRedmineService RedmineService
@inject AppState AppState
@inject NotificationService Notification

@if (IsVisible)
{
    <div class="modal-backdrop" @onclick="Close"></div>
    <div class="modal-dialog new-issue-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3>Nueva tarea</h3>
                <button class="close" @onclick="Close">&times;</button>
            </div>
            <EditForm Model="_model" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />
                <div class="modal-body">
                    <ValidationSummary />
                    <div class="ni-fields-grid">
                        <div class="form-group ni-full">
                            <label>Título</label>
                            <input class="form-control" @bind="_model.Subject" required maxlength="255" placeholder="Título de la tarea..." />
                        </div>
                        <div class="form-group">
                            <label>Proyecto</label>
                            <select class="form-control" @bind="_model.ProjectId" required>
                                <option value="">Seleccione...</option>
                                @foreach (var project in Projects)
                                {
                                    <option value="@project.Id">@project.Name</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Tipo</label>
                            <select class="form-control" @bind="_model.TrackerId" required>
                                <option value="">Seleccione...</option>
                                @foreach (var tracker in Trackers)
                                {
                                    <option value="@tracker.Id">@tracker.Name</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Estado</label>
                            <select class="form-control" @bind="_model.StatusId" required>
                                <option value="">Seleccione...</option>
                                @foreach (var status in Statuses)
                                {
                                    <option value="@status.Id">@status.Name</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Prioridad</label>
                            <select class="form-control" @bind="_model.PriorityId">
                                <option value="">Seleccione...</option>
                                @foreach (var priority in Priorities)
                                {
                                    <option value="@priority.Id">@priority.Name</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Asignado a</label>
                            <select class="form-control" @bind="_model.AssignedToId">
                                <option value="">Sin asignar</option>
                                @foreach (var user in Users)
                                {
                                    <option value="@user.Id">@user.Name</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Fecha de vencimiento</label>
                            <input type="date" class="form-control" @bind="_model.DueDate" />
                        </div>
                        <div class="form-group ni-full">
                            <label>Descripción</label>
                            <textarea class="form-control" @bind="_model.Description" rows="3" placeholder="Descripción opcional..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary" disabled="@_isSaving">Crear</button>
                    <button type="button" class="btn btn-secondary" @onclick="Close">Cancelar</button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnIssueCreated { get; set; }
    [Parameter] public List<RedmineProject> Projects { get; set; } = new();
    [Parameter] public List<RedmineReference> Priorities { get; set; } = new();
    [Parameter] public List<RedmineReference> Users { get; set; } = new();
    [Parameter] public List<RedmineReference> Trackers { get; set; } = new();
    [Parameter] public List<RedmineStatus> Statuses { get; set; } = new();

    private KanbanRedmine.Services.NewIssueModel _model = new();
    private bool _isSaving = false;

    private void Close()
    {
        if (!_isSaving)
        {
            _model = new();
            OnClose.InvokeAsync();
        }
    }

    private async Task HandleValidSubmit()
    {
        _isSaving = true;
        try
        {
            var apiKey = AppState.ApiKey;
            if (string.IsNullOrEmpty(apiKey)) return;

            // Debug log to check the model values
            Console.WriteLine("Submitting new issue with the following data:");
            Console.WriteLine($"ProjectId: {_model.ProjectId}");
            Console.WriteLine($"TrackerId: {_model.TrackerId}");
            Console.WriteLine($"StatusId: {_model.StatusId}");
            Console.WriteLine($"Subject: {_model.Subject}");
            Console.WriteLine($"Description: {_model.Description}");
            Console.WriteLine($"PriorityId: {_model.PriorityId}");
            Console.WriteLine($"AssignedToId: {_model.AssignedToId}");
            Console.WriteLine($"DueDate: {_model.DueDate}");

            var result = await RedmineService.CreateIssueAsync(apiKey, _model);
            Console.WriteLine($"API call result: Success={result.Success}, ErrorMessage={result.ErrorMessage}");
            if (result.Success)
            {
                Notification.ShowSuccess("Tarea creada correctamente");
                await OnIssueCreated.InvokeAsync();
            }
            else
            {
                Notification.ShowError(result.ErrorMessage ?? "Error al crear tarea");
            }
        }
        finally
        {
            _isSaving = false;
            Close();
        }
    }
}
